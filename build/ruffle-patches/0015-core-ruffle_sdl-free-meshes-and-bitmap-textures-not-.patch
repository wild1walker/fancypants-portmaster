From ae322b693a2f74295fdb754a5d4a4d0fd0c2bb5a Mon Sep 17 00:00:00 2001
From: port <port@localhost>
Date: Tue, 13 Oct 2026 19:18:57 +0000
Subject: [PATCH] core, ruffle_sdl: free meshes and bitmap textures not drawn
 lately when memory runs low

Ruffle keeps the tessellation of every shape it has drawn and the GPU
texture of every library bitmap a shape filled with, for the life of the
movie (a FIXME in BitmapCharacter::bitmap_handle). Worlds 2 and 3 of Fancy
Pants Adventures draw each level's art into cache bitmaps when the level
loads and never draw those shapes again, so every level visited added its
meshes and fill textures for good: memory grew as the game went on, and
1 GB handhelds needed zram for longer sessions.

* A drawn shape notes the current render epoch. ruffle_sdl starts a new
  epoch every 5 s (not while paused).
* When the system has less than RUFFLE_EVICT_MB (default 350, 0 = never)
  of memory available, Player::evict_unused_render_data(4) drops the
  tessellations of lazily tessellated shapes not drawn in the last 4
  epochs (15 to 20 s), then the textures of library bitmaps that no mesh
  holds any more (the library's handle is the only reference left), and
  ruffle_sdl trims the heap. Both are made again on their next draw, the
  same way lazy shapes are made on their first. With more memory free
  nothing is dropped, so devices with more RAM behave as before.
* BitmapCharacter keeps its handle in a RefCell instead of a OnceCell so
  it can be dropped.
---
 core/src/character.rs              | 30 ++++++++++++++-----
 core/src/display_object.rs         |  1 +
 core/src/display_object/graphic.rs | 37 +++++++++++++++++++++++-
 core/src/library.rs                | 25 ++++++++++++++++
 core/src/player.rs                 | 18 ++++++++++++
 sdl/src/main.rs                    | 46 ++++++++++++++++++++++++++++++
 6 files changed, 149 insertions(+), 8 deletions(-)

diff --git a/core/src/character.rs b/core/src/character.rs
index 9901c15b3..19720f82f 100644
--- a/core/src/character.rs
+++ b/core/src/character.rs
@@ -1,4 +1,4 @@
-use std::cell::OnceCell;
+use std::cell::RefCell;
 
 use crate::backend::audio::SoundHandle;
 use crate::binary_data::BinaryData;
@@ -37,8 +37,9 @@ pub struct BitmapCharacter<'gc> {
     #[collect(require_static)]
     compressed: CompressedBitmap,
     /// A lazily constructed GPU handle, used when performing fills with this bitmap
+    /// (PortMaster port: dropped again by `evict_unused_handle` once no mesh uses it)
     #[collect(require_static)]
-    handle: OnceCell<BitmapHandle>,
+    handle: RefCell<Option<BitmapHandle>>,
     /// The bitmap class set by `SymbolClass` - this is used when we instantaite
     /// a `Bitmap` displayobject.
     avm2_class: Lock<BitmapClass<'gc>>,
@@ -61,7 +62,7 @@ impl<'gc> BitmapCharacter<'gc> {
         );
         Self {
             compressed,
-            handle: OnceCell::default(),
+            handle: RefCell::new(None),
             avm2_class: Lock::new(BitmapClass::NoSubclass),
         }
     }
@@ -82,16 +83,31 @@ impl<'gc> BitmapCharacter<'gc> {
         &self,
         backend: &mut dyn RenderBackend,
     ) -> Result<BitmapHandle, RenderError> {
-        // FIXME - use `OnceCell::get_or_try_init` when stabilized.
-        if let Some(handle) = self.handle.get() {
+        if let Some(handle) = self.handle.borrow().as_ref() {
             return Ok(handle.clone());
         }
         let decoded = self.compressed.decode()?;
         let new_handle = backend.register_bitmap(decoded)?;
-        // FIXME - do we ever want to release this handle, to avoid taking up GPU memory?
-        self.handle.set(new_handle.clone()).unwrap();
+        *self.handle.borrow_mut() = Some(new_handle.clone());
         Ok(new_handle)
     }
+
+    /// PortMaster port: drops the GPU texture when nothing but the library holds it (no mesh
+    /// fills with it any more); the next fill decodes and uploads the bitmap again.
+    pub fn evict_unused_handle(&self) -> bool {
+        let Ok(mut handle) = self.handle.try_borrow_mut() else {
+            return false;
+        };
+        if handle
+            .as_ref()
+            .is_some_and(|h| std::sync::Arc::strong_count(&h.0) == 1)
+        {
+            *handle = None;
+            true
+        } else {
+            false
+        }
+    }
 }
 
