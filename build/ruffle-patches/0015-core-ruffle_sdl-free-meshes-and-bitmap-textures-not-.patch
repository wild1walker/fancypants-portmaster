         Graphic(Gc::new(
@@ -167,6 +170,24 @@ impl<'gc> Graphic<'gc> {
         unlock!(Gc::write(mc, self.0), GraphicData, shared).set(shared);
     }
 
+    /// PortMaster port: drops the tessellations of a lazily tessellated shape that has not been
+    /// drawn since epoch `before`; the next draw tessellates it again. Returns how many meshes
+    /// were dropped.
+    pub(crate) fn evict_unused_meshes(self, before: u32) -> usize {
+        let shared = self.0.shared.get();
+        if shared.render_handle.is_some() || shared.last_drawn.get() >= before {
+            return 0;
+        }
+        let Ok(mut cache) = shared.scaled_handle.try_borrow_mut() else {
+            return 0;
+        };
+        let n = cache.len();
+        if n > 0 {
+            *cache = TessellationCache::new();
+        }
+        n
+    }
+
     /// Returns the best shape handle for the current scale, retessellating if necessary.
     fn get_or_retessellate_handle(
         self,
@@ -177,6 +198,7 @@ impl<'gc> Graphic<'gc> {
         // Since graphics are created from a shared shape, we may be able to reuse a
         // cached tessellation from another instance at a similar scale.
         let shared = self.0.shared.get();
+        shared.last_drawn.set(RENDER_EPOCH.load(Ordering::Relaxed));
 
         {
             let mut cache = shared.scaled_handle.borrow_mut();
@@ -402,6 +424,19 @@ struct GraphicShared {
     movie: Arc<SwfMovie>,
     #[collect(require_static)]
     scaled_handle: RefCell<TessellationCache>,
+    /// PortMaster port: the eviction epoch in which the shape was last drawn
+    /// (`evict_unused_meshes`).
+    #[collect(require_static)]
+    last_drawn: Cell<u32>,
+}
+
+/// PortMaster port: a counter the front end advances every few seconds
+/// (`Player::advance_render_epoch`); a drawn shape notes its value.
+static RENDER_EPOCH: AtomicU32 = AtomicU32::new(1);
+
+/// PortMaster port: starts a new eviction epoch and returns it.
+pub(crate) fn advance_render_epoch() -> u32 {
+    RENDER_EPOCH.fetch_add(1, Ordering::Relaxed) + 1
 }
 
 /// PortMaster port: `RUFFLE_LAZY_SHAPES` (default on; "0" turns it off): DefineShape characters are
diff --git a/core/src/library.rs b/core/src/library.rs
index 74188cd5e..4f1d5b4c0 100644
--- a/core/src/library.rs
+++ b/core/src/library.rs
@@ -372,6 +372,31 @@ impl<'gc> MovieLibrary<'gc> {
     }
 }
 
+impl<'gc> Library<'gc> {
+    /// PortMaster port: frees the meshes of shapes not drawn since epoch `before`, then the
+    /// textures of library bitmaps no mesh uses any more. Returns (meshes, bitmaps) freed.
+    pub fn evict_unused_render_data(&self, before: u32) -> (usize, usize) {
+        let (mut meshes, mut bitmaps) = (0, 0);
+        for (_, library) in self.movie_libraries.0.iter() {
+            for character in library.characters.values() {
+                if let Character::Graphic(graphic) = character {
+                    meshes += graphic.evict_unused_meshes(before);
+                }
+            }
+        }
+        for (_, library) in self.movie_libraries.0.iter() {
+            for character in library.characters.values() {
+                if let Character::Bitmap(bitmap) = character
+                    && bitmap.evict_unused_handle()
+                {
+                    bitmaps += 1;
+                }
+            }
+        }
+        (meshes, bitmaps)
+    }
+}
+
 pub struct MovieLibrarySource<'a, 'gc> {
     pub library: &'a MovieLibrary<'gc>,
 }
diff --git a/core/src/player.rs b/core/src/player.rs
index 43ee6390d..d2b84b525 100644
--- a/core/src/player.rs
+++ b/core/src/player.rs
@@ -2477,6 +2477,24 @@ impl Player {
         PORT_FRAMESKIP.store(if on { 2 } else { 1 }, std::sync::atomic::Ordering::Relaxed);
     }
 
+    /// PortMaster port: starts a new render epoch (a front end calls this every few seconds);
+    /// shapes drawn from now on note it.
+    pub fn advance_render_epoch(&mut self) -> u32 {
+        crate::display_object::advance_render_epoch()
+    }
+
+    /// PortMaster port: frees the meshes of shapes that have not been drawn in the last `epochs`
+    /// render epochs and the bitmap textures no mesh uses any more (both are made again on their
+    /// next draw). Returns (meshes, bitmaps) freed.
+    pub fn evict_unused_render_data(&mut self, epochs: u32) -> (usize, usize) {
+        let now = crate::display_object::advance_render_epoch();
+        let before = now.saturating_sub(epochs);
+        if before == 0 {
+            return (0, 0);
+        }
+        self.mutate_with_update_context(|context| context.library.evict_unused_render_data(before))
+    }
+
     /// Runs the collector to the end of a cycle now (frees everything unreachable at once).
     pub fn collect_garbage_now(&mut self) {
         self.gc_arena.borrow_mut().finish_cycle();
diff --git a/sdl/src/main.rs b/sdl/src/main.rs
index de9c315aa..229e76c46 100644
--- a/sdl/src/main.rs
+++ b/sdl/src/main.rs
@@ -556,6 +556,17 @@ fn main() -> anyhow::Result<()> {
     let mut pacer = port::Pacer::new(refresh_hz, pacing);
     // What a malloc_trim took last time; it runs when the frame has that much time to spare
     let mut trim_cost = Duration::from_millis(4);
+    // Low memory: every 5 s a new render epoch starts; when the system has less than
+    // RUFFLE_EVICT_MB (350, 0 = never) of memory available, the meshes of shapes not drawn in
+    // the last 4 epochs (15 to 20 s) and the bitmap textures no mesh uses any more are freed.
+    // They are made again when next drawn. Worlds 2 and 3 draw their level art into cache
+    // bitmaps when a level loads and never draw those shapes again, but kept their meshes and
+    // textures for every level visited.
+    let evict_below_mb: u64 = std::env::var("RUFFLE_EVICT_MB")
+        .ok()
+        .and_then(|v| v.parse().ok())
+        .unwrap_or(350);
+    let mut last_epoch = Instant::now();
 
     'main: loop {
         // releases held back by the minimum key hold that are now due
@@ -864,6 +875,33 @@ fn main() -> anyhow::Result<()> {
                 );
             }
         }
+        // (not while paused: every shape would look unused after a long pause)
+        if paused.is_none() && last_epoch.elapsed() >= Duration::from_secs(5) {
+            last_epoch = Instant::now();
+            let mut player = player.lock().expect("player lock");
+            match mem_available_mb() {
+                Some(avail) if avail < evict_below_mb => {
+                    let start = Instant::now();
+                    let (meshes, bitmaps) = player.evict_unused_render_data(4);
+                    drop(player);
+                    if meshes + bitmaps > 0 {
+                        let rss0 = rss_mb();
+                        trim_heap();
+                        last_trim = Instant::now();
+                        tracing::info!(
+                            "low memory ({avail} MB available): freed {meshes} meshes and \
+                             {bitmaps} bitmap textures not drawn lately in {:?}, rss {rss0} -> {} MB",
+                            start.elapsed(),
+                            rss_mb()
+                        );
+                    }
+                }
+                _ => {
+                    player.advance_render_epoch();
+                }
+            }
+        }
+
         // The heap trim runs where it does not delay a frame: in the time before the next frame
         // is due (or while paused), else at the latest every 8 trim periods (the hub has no time
         // to spare). Right after a load (a long tick) it runs at once, with a full collection.
@@ -1081,6 +1119,14 @@ fn spawn_memlog() {
     });
 }
 
+/// MemAvailable from /proc/meminfo, in MB.
+fn mem_available_mb() -> Option<u64> {
+    let info = std::fs::read_to_string("/proc/meminfo").ok()?;
+    let line = info.lines().find(|l| l.starts_with("MemAvailable:"))?;
+    let kb: u64 = line.split_whitespace().nth(1)?.parse().ok()?;
+    Some(kb / 1024)
+}
+
 fn rss_mb() -> u64 {
     std::fs::read_to_string("/proc/self/statm")
         .ok()
