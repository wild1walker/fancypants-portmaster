@@ -0,0 +1,338 @@
+//! PortMaster port helpers for the main loop: a front end pause with an on-screen banner (for
+//! movies that have no pause of their own, like the Fancy Pants Adventures hub), a navigator that
+//! notes which files the movie loads (so a mode can follow the world that is running), and frame
+//! pacing that presents each frame on an even vsync cadence.
+
+use async_channel::{Receiver, Sender};
+use glow::HasContext;
+use ruffle_core::backend::navigator::{
+    ErrorResponse, NavigationMethod, NavigatorBackend, NullNavigatorBackend, OwnedFuture,
+    SuccessResponse,
+};
+use ruffle_core::indexmap::IndexMap;
+use ruffle_core::loader::Error;
+use ruffle_core::socket::{SocketAction, SocketHandle};
+use std::cell::RefCell;
+use std::rc::Rc;
+use std::time::{Duration, Instant};
+use url::{ParseError, Url};
+
+/// `NullNavigatorBackend` that records the file name of every fetch, so the main loop can tell
+/// which world the movie has loaded.
+pub struct WatchingNavigator {
+    inner: NullNavigatorBackend,
+    pub fetched: Rc<RefCell<Vec<String>>>,
+}
+
+impl WatchingNavigator {
+    pub fn new(inner: NullNavigatorBackend) -> Self {
+        Self {
+            inner,
+            fetched: Rc::new(RefCell::new(Vec::new())),
+        }
+    }
+}
+
+impl NavigatorBackend for WatchingNavigator {
+    fn navigate_to_url(
+        &self,
+        url: &str,
+        target: &str,
+        vars_method: Option<(NavigationMethod, IndexMap<String, String>)>,
+    ) {
+        self.inner.navigate_to_url(url, target, vars_method)
+    }
+
+    fn fetch(
+        &self,
+        request: ruffle_core::backend::navigator::Request,
+    ) -> OwnedFuture<Box<dyn SuccessResponse>, ErrorResponse> {
+        let name = request
+            .url()
+            .rsplit(['/', '\\'])
+            .next()
+            .unwrap_or_default()
+            .split(['?', '#'])
+            .next()
+            .unwrap_or_default()
+            .to_string();
+        self.fetched.borrow_mut().push(name);
+        self.inner.fetch(request)
+    }
+
+    fn resolve_url(&self, url: &str) -> Result<Url, ParseError> {
+        self.inner.resolve_url(url)
+    }
+
+    fn spawn_future(&mut self, future: OwnedFuture<(), Error>) {
+        self.inner.spawn_future(future)
+    }
+
+    fn pre_process_url(&self, url: Url) -> Url {
+        self.inner.pre_process_url(url)
+    }
+
+    fn connect_socket(
+        &mut self,
+        host: String,
+        port: u16,
+        timeout: Duration,
+        handle: SocketHandle,
+        receiver: Receiver<Vec<u8>>,
+        sender: Sender<SocketAction>,
+    ) {
+        self.inner
+            .connect_socket(host, port, timeout, handle, receiver, sender)
+    }
+}
+
+/// 5x7 pixel glyphs for the pause banner (one byte per row, the low 5 bits, left to right).
+fn glyph(c: char) -> [u8; 7] {
+    match c {
+        'A' => [0x0e, 0x11, 0x11, 0x1f, 0x11, 0x11, 0x11],
+        'C' => [0x0e, 0x11, 0x10, 0x10, 0x10, 0x11, 0x0e],
+        'D' => [0x1e, 0x11, 0x11, 0x11, 0x11, 0x11, 0x1e],
+        'E' => [0x1f, 0x10, 0x10, 0x1e, 0x10, 0x10, 0x1f],
+        'I' => [0x0e, 0x04, 0x04, 0x04, 0x04, 0x04, 0x0e],
+        'L' => [0x10, 0x10, 0x10, 0x10, 0x10, 0x10, 0x1f],
+        'M' => [0x11, 0x1b, 0x15, 0x15, 0x11, 0x11, 0x11],
+        'P' => [0x1e, 0x11, 0x11, 0x1e, 0x10, 0x10, 0x10],
+        'Q' => [0x0e, 0x11, 0x11, 0x11, 0x15, 0x12, 0x0d],
+        'R' => [0x1e, 0x11, 0x11, 0x1e, 0x14, 0x12, 0x11],
+        'S' => [0x0f, 0x10, 0x10, 0x0e, 0x01, 0x01, 0x1e],
+        'T' => [0x1f, 0x04, 0x04, 0x04, 0x04, 0x04, 0x04],
+        'U' => [0x11, 0x11, 0x11, 0x11, 0x11, 0x11, 0x0e],
+        '+' => [0x00, 0x04, 0x04, 0x1f, 0x04, 0x04, 0x00],
+        ':' => [0x00, 0x0c, 0x0c, 0x00, 0x0c, 0x0c, 0x00],
+        _ => [0; 7],
+    }
+}
+
+/// Width in pixels of `text` drawn at `scale` (6 columns per character, the last one blank).
+fn text_width(text: &str, scale: i32) -> i32 {
+    (text.chars().count() as i32 * 6 - 1) * scale
+}
+
+/// Fills a rectangle given in top-left screen coordinates (GL scissor counts from the bottom).
+unsafe fn fill(gl: &glow::Context, sh: i32, x: i32, y: i32, w: i32, h: i32, rgb: f32) {
+    unsafe {
+        gl.scissor(x, sh - y - h, w, h);
+        gl.clear_color(rgb, rgb, rgb, 1.0);
+        gl.clear(glow::COLOR_BUFFER_BIT);
+    }
+}
+
+unsafe fn draw_text(gl: &glow::Context, sh: i32, text: &str, x: i32, y: i32, scale: i32) {
+    for (i, c) in text.chars().enumerate() {
+        let cx = x + i as i32 * 6 * scale;
+        for (row, bits) in glyph(c).iter().enumerate() {
+            // one rectangle per horizontal run of lit pixels
+            let mut col = 0;
+            while col < 5 {
+                if bits & (0x10 >> col) == 0 {
+                    col += 1;
+                    continue;
+                }
+                let start = col;
+                while col < 5 && bits & (0x10 >> col) != 0 {
+                    col += 1;
+                }
+                unsafe {
+                    fill(
+                        gl,
+                        sh,
+                        cx + start * scale,
+                        y + row as i32 * scale,
+                        (col - start) * scale,
+                        scale,
+                        1.0,
+                    )
+                };
+            }
+        }
+    }
+}
+
+/// Draws the pause banner over whatever is in the window's back buffer: a black band across the
+/// middle of the screen with "PAUSED" and the buttons to resume or quit. Only uses scissored
+/// clears, so it needs no shader and leaves no GL state behind that wgpu relies on.
+pub fn draw_pause_banner(gl: &glow::Context, sw: u32, sh: u32) {
+    const TITLE: &str = "PAUSED";
+    const HINT: &str = "START: RESUME   SELECT+START: QUIT";
+    let (sw, sh) = (sw as i32, sh as i32);
+    let big = (sh / 80).max(2);
+    let mut small = (sh / 240).max(1);
+    while small > 1 && text_width(HINT, small) > sw - 8 {
+        small -= 1;
+    }
+    let pad = big * 3;
+    let band_h = pad + 7 * big + pad + 7 * small + pad;
+    let band_y = (sh - band_h) / 2;
+    unsafe {
+        gl.bind_framebuffer(glow::DRAW_FRAMEBUFFER, None);
+        gl.viewport(0, 0, sw, sh);
+        gl.color_mask(true, true, true, true);
+        gl.enable(glow::SCISSOR_TEST);
+        fill(gl, sh, 0, band_y, sw, band_h, 0.0);
+        draw_text(
+            gl,
+            sh,
+            TITLE,
+            (sw - text_width(TITLE, big)) / 2,
+            band_y + pad,
+            big,
+        );
+        draw_text(
+            gl,
+            sh,
+            HINT,
+            (sw - text_width(HINT, small)) / 2,
+            band_y + pad + 7 * big + pad,
+            small,
+        );
+        gl.disable(glow::SCISSOR_TEST);
+    }
+}
+
+/// Presents frames on an even vsync cadence.
+///
+/// With a blocking swap (vsync) a 30 fps movie on a 60 Hz screen should be shown every second
+/// refresh. Ruffle's frames are timed by the clock, though, and a swap shows the frame at the
+/// first refresh after the frame is done: a frame that took 14 ms appeared one refresh after its
+/// tick, one that took 19 ms two refreshes after it, so frames were held on screen for one, two or
+/// three refreshes in turn (judder), and the clock drifting against the screen's real rate moved
+/// frames across refreshes every few seconds. The pacer
+/// * holds a frame back until the refresh before its slot has passed, so it is shown exactly
+///   `per_frame` refreshes after the previous one, however long it took to draw (up to the slot),
+/// * lets the next tick run right after the swap instead of waiting for the clock, and
+/// * rounds the tick's time step to whole movie frames when it is within 15% of one, so a frame
+///   runs on every slot instead of being put off by a fraction of a millisecond.
+///
+/// It stays off when the screen's refresh rate is unknown, and turns itself off when swaps turn
+/// out not to wait for the refresh (no vsync, or a driver that queues frames).
+pub struct Pacer {
+    period: Option<Duration>,
+    /// When the last swap that waited for the refresh returned (a refresh)
+    last_present: Option<Instant>,
+    /// The last swap returned at a refresh, so the next tick can run right away
+    pub just_presented: bool,
+    swaps: u32,
+    waited: u32,
+}
+
+impl Pacer {
+    pub fn new(refresh_hz: i32, enabled: bool) -> Self {
+        let period = (enabled && (20..=250).contains(&refresh_hz))
+            .then(|| Duration::from_secs_f64(1.0 / refresh_hz as f64));
+        if let Some(period) = period {
+            tracing::info!("frame pacing on a {refresh_hz} Hz screen ({period:?} per refresh)");
+        }
+        Self {
+            period,
+            last_present: None,
+            just_presented: false,
+            swaps: 0,
+            waited: 0,
+        }
+    }
+
+    /// Refreshes per movie frame, when the movie's rate divides the screen's (60 Hz and 30 fps:
+    /// 2), else 1.
+    fn per_frame(&self, frame_rate: f64) -> u32 {
+        let Some(period) = self.period else {
+            return 1;
+        };
+        if frame_rate <= 0.0 || !frame_rate.is_finite() {
+            return 1;
+        }
+        let ratio = 1.0 / (period.as_secs_f64() * frame_rate);
+        let n = ratio.round();
+        if n >= 2.0 && (ratio - n).abs() < 0.1 {
+            n as u32
+        } else {
+            1
+        }
+    }
+
+    /// The time step for the next tick: within 15% of a whole number of movie frames, exactly
+    /// that number of frames.
+    pub fn snap(&self, dt: Duration, frame_rate: f64) -> Duration {
+        // only once swaps have been seen to wait for the refresh
+        if self.period.is_none() || self.waited < 10 || frame_rate <= 0.0 || !frame_rate.is_finite()
+        {
+            return dt;
+        }
+        let frame = 1.0 / frame_rate;
+        let frames = (dt.as_secs_f64() / frame).round();
+        if frames >= 1.0 && (dt.as_secs_f64() - frames * frame).abs() <= 0.15 * frame {
+            // a hair over, so the accumulator never ends a whisker short of a frame
+            Duration::from_secs_f64(frames * frame + 1e-6)
+        } else {
+            dt
+        }
+    }
+
+    /// How long the main thread can spend on other work (a heap trim) before it has to swap to
+    /// make this frame's slot, or `None` without pacing.
+    pub fn slack(&self, frame_rate: f64) -> Option<Duration> {
+        let (period, last) = (self.period?, self.last_present?);
+        let deadline = last + period * self.per_frame(frame_rate);
+        Some(deadline.saturating_duration_since(Instant::now() + Duration::from_micros(1500)))
+    }
+
+    /// Call right before the swap: waits until the refresh before this frame's slot has passed.
+    pub fn before_swap(&self, frame_rate: f64) {
+        let (Some(period), Some(last)) = (self.period, self.last_present) else {
+            return;
+        };
+        let n = self.per_frame(frame_rate);
+        if n < 2 {
+            return;
+        }
+        let earliest = last + period * (n - 1) + Duration::from_micros(1500);
+        let now = Instant::now();
+        // only for the frame right after the last present (not after a pause or a load)
+        if now < earliest && earliest - now < period * n {
+            std::thread::sleep(earliest - now);
+        }
+    }
+
+    /// Call right after the swap with how long the swap took.
+    pub fn after_swap(&mut self, swap_time: Duration) {
+        let Some(period) = self.period else {
+            return;
+        };
+        self.swaps += 1;
+        if swap_time >= period / 4 {
+            self.waited += 1;
+            self.last_present = Some(Instant::now());
+            self.just_presented = true;
+        } else {
+            self.just_presented = false;
+        }
+        // check once, early: do swaps wait for the refresh at all?
+        if self.swaps == 120 {
+            if self.waited < 30 {
+                tracing::info!(
+                    "frame pacing off: only {} of {} swaps waited for a refresh",
+                    self.waited,
+                    self.swaps
+                );
+                self.period = None;
+                self.last_present = None;
+                self.just_presented = false;
+            }
+        }
+    }
+
+    /// Forget the last present (after a pause or anything else that stopped the frames).
+    pub fn reset(&mut self) {
+        self.last_present = None;
+        self.just_presented = false;
+    }
+
+    /// Waits shorter than this after a present are skipped (the frame is due at this refresh).
+    pub fn early_tick(&self) -> Option<Duration> {
+        self.period.filter(|_| self.just_presented).map(|p| p / 2)
+    }
+}
